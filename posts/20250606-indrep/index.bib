@book{curtis_methods_1990,
	title = {Methods of Representation Theory: With Applications to Finite Groups and Orders},
	isbn = {978-0-471-52367-3},
	shorttitle = {Methods of Representation Theory},
	abstract = {A comprehensive, modern treatment of representation theory of finite groups and orders that discusses theory, applications and connections to other branches of mathematics. Written by two experts in the field, it covers classical, modular and integral representation theory and contains many new, important results. Beginning with an introductory review of ring theory, algebraic number theory and homological algebra, it progresses to topics such as classification of indecomposable representations and Burnside rings. Included are a wealth of illustrative examples and auxiliary results as well as exercises to reinforce learning.},
