@misc{geneste_root_2018,
	title = {Root systems, symmetries and linear representations of Artin groups},
	doi = {10.48550/arXiv.1804.07519},
	abstract = {Let \$Γ\$ be a Coxeter graph, let \$W\$ be its associated Coxeter group, and let \$G\$ be a group of symmetries of \$Γ\$.Recall that, by a theorem of H\{é\}e and Mühlherr, \$W{\textasciicircum}G\$ is a Coxeter group associated to some Coxeter graph \${\textbackslash}hat Γ\$.We denote by \$Φ{\textasciicircum}+\$ the set of positive roots of \$Γ\$ and by \${\textbackslash}hat Φ{\textasciicircum}+\$ the set of positive roots of \${\textbackslash}hat Γ\$.Let \$E\$ be a vector space over a field \${\textbackslash}K\$ having a basis in one-to-one correspondence with \$Φ{\textasciicircum}+\$.The action of \$G\$ on \$Γ\$ induces an action of \$G\$ on \$Φ{\textasciicircum}+\$, and therefore on \$E\$.We show that \$E{\textasciicircum}G\$ contains a linearly independent family of vectors naturally in one-to-one correspondence with \${\textbackslash}hat Φ{\textasciicircum}+\$ and we determine exactly when this family is a basis of \$E{\textasciicircum}G\$.This question is motivated by the construction of Krammer's style linear representations for non simply laced Artin groups.},
	number = {{arXiv}:1804.07519},
	publisher = {{arXiv}},
	author = {Geneste, Olivier and Hée, Jean-Yves and Paris, Luis},
	urldate = {2026-09-26},
	date = {2018-04-20},
	eprinttype = {arxiv},
	eprint = {1804.07519 [math.GR]},
	keywords = {Mathematics - Group Theory},
}
